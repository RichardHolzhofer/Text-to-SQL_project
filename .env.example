# Snowflake account and shared warehouse settings
SNOWFLAKE_ACCOUNT=your_account_identifier
DBT_SNOWFLAKE_DATABASE=your_database
DBT_SNOWFLAKE_WAREHOUSE=your_warehouse

# Snowflake dbt/write identity
DBT_SNOWFLAKE_ROLE=your_dbt_role
DBT_SNOWFLAKE_SCHEMA=your_dbt_schema
DBT_SNOWFLAKE_USER=your_dbt_user
DBT_SNOWFLAKE_PASSWORD=your_dbt_password

# Snowflake agent/read-only identity
AGENT_SNOWFLAKE_ROLE=your_agent_role
AGENT_SNOWFLAKE_SCHEMA=your_agent_schema
AGENT_SNOWFLAKE_USER=your_agent_user
AGENT_SNOWFLAKE_PASSWORD=your_agent_password

# Supabase project, auth, and Postgres connection
SUPABASE_PROJECT_NAME=your_supabase_project_name
SUPABASE_DB_URI=postgresql://postgres:password@host:5432/postgres
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_PASSWORD=your_supabase_database_password

# Langfuse prompt management and tracing
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com

# LLM and embedding models
# Examples: openai:gpt-4.1, openai:gpt-4.1-mini, groq:llama-3.3-70b-versatile
SMART_LLM_MODEL=openai:gpt-4.1
FAST_LLM_MODEL=openai:gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE=0.0

# Provider API keys
OPENAI_API_KEY=your_openai_api_key
GROQ_API_KEY=

# LangGraph runtime
LANGGRAPH_URL=http://localhost:2024

# Optional MCP server credentials and metadata
MCP_USER_ID=
MCP_USER_EMAIL=
MCP_USER_PASSWORD=
HOST_PROJECT_PATH=
FAST_MODEL=gpt-4o-mini
SMART_MODEL=gpt-4o
