FROM python:3.12-slim

# Install uv for package management
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Set the working directory
WORKDIR /app

ENV UV_COMPILE_BYTECODE=1
ENV PYTHONPATH=/app

# Copy only dependency files
COPY pyproject.toml uv.lock ./

# Install dependencies using uv sync
RUN uv sync --frozen --no-install-project --no-dev

# Copy the entire project into the container
COPY . .

# Expose the default FastMCP SSE port
EXPOSE 8000

# Healthcheck to verify SSE port is accessible
HEALTHCHECK CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/sse')"

# Run the FastMCP server
ENTRYPOINT ["uv", "run", "python", "src/mcp/server.py"]
